---
import { categories, route } from '../data/projects';
import '../styles/site.css';
import '../styles/atmosphere.css';

const { title, description = 'Jennings Li 的个人作品集，涵盖品牌视觉、商业视频与 AI 辅助创作。', section = '', image, overlayHeader = false } = Astro.props;
const navigation = [
  { key: 'work', label: '作品', href: route('work/') },
  { key: 'lab', label: categories.motion, href: route('ai-lab/') },
  { key: 'goodlooks', label: categories.goodlooks, href: route('work/?category=goodlooks'), lang: 'en' },
  { key: 'experiments', label: '实验', href: route('experiments/') },
  { key: 'about', label: '关于', href: route('about/') },
];
const pageTitle = title ? `${title} | Jennings Li` : 'Jennings Li | 品牌视觉、商业影像与 AI 创作';
const themeColor = overlayHeader ? (Astro.props.theme === 'cinema-home' ? '#282018' : '#101f2b') : '#eef5f1';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={route('icon.png')} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={Astro.site ? new URL(image, Astro.site).href : image} />}
    <meta name="theme-color" content={themeColor} />
    <title>{pageTitle}</title>
  </head>
  <body data-theme={Astro.props.theme}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class:list={['site-header', { 'is-overlay': overlayHeader }]}>
      <div class="shell header-inner">
        <a class="wordmark" href={route()} aria-label="Jennings Li · 首页" lang="en">Jennings Li</a>
        <nav aria-label="主导航">
          {navigation.map(item => <a href={item.href} lang={item.lang} data-nav-section={item.key} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="wordmark" href={route()} aria-label="Jennings Li · 首页" lang="en">Jennings Li</a>
        <span>品牌视觉 · 商业影像 · AI 创作</span>
        <a class="text-link" href={route('about/')}>关于我</a>
      </div>
    </footer>
  </body>
</html>
